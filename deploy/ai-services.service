[Unit]
Description=Ecosystem AI Services (Docker Compose)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ecosystem-ai-services
ExecStart=/usr/bin/docker compose -f docker-compose.demo.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.demo.yml down
StandardOutput=journal

[Install]
WantedBy=multi-user.target
